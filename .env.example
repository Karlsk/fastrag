# FastRAG Configuration
# All settings can be prefixed with FASTRAG_ or used directly

# LLM / Embedding (OpenAI-compatible)
FASTRAG_OPENAI_API_KEY=sk-xxx
FASTRAG_OPENAI_BASE_URL=https://api.openai.com/v1
FASTRAG_LLM_MODEL=gpt-4o-mini
FASTRAG_EMBEDDING_MODEL=text-embedding-3-small
FASTRAG_RERANK_MODEL=

# Milvus Vector Store
FASTRAG_MILVUS_URI=http://localhost:19530
FASTRAG_MILVUS_TOKEN=

# Timeouts
FASTRAG_LLM_TIMEOUT=600
FASTRAG_LLM_MAX_RETRIES=3
