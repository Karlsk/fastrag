# FastRAG Configuration
# All settings can be prefixed with FASTRAG_ or used directly

# LLM / Embedding (OpenAI-compatible)
FASTRAG_OPENAI_API_KEY=sk-xx
FASTRAG_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
FASTRAG_LLM_MODEL=Qwen/Qwen3.5-35B-A3B
FASTRAG_EMBEDDING_MODEL=BAAI/bge-m3
FASTRAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Milvus Vector Store
# Milvus Standalone (embedded etcd + local storage) does NOT require authentication.
# For Docker Compose deployment, use the service name: http://milvus:19530
# For local development, use: http://localhost:19530
FASTRAG_MILVUS_URI=http://localhost:19530
FASTRAG_MILVUS_TOKEN=

# Timeouts
FASTRAG_LLM_TIMEOUT=100
FASTRAG_LLM_MAX_RETRIES=3

# Logging
FASTRAG_LOG_LEVEL=INFO
# FASTRAG_LOG_DIR=/tmp/fastrag_logs
